generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              String                           @id @default(cuid())
  email                           String                           @unique
  notificationEmail               String? // Optional separate email for notifications
  password                        String
  name                            String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  isAdmin                         Boolean                          @default(false)
  role                            UserRole                         @default(CLEANER)
  // Site membership. OP and DIRECTOR span every site (siteId null = all sites);
  // MANAGER and CLEANER are pinned to exactly one site.
  siteId                          String?
  site                            Site?                            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tasks                           Task[]                           @relation("UserTasks")
  sessions                        UserSession[]
  roomScheduleCompletionLogs      RoomScheduleCompletionLog[]
  equipmentScheduleCompletionLogs EquipmentScheduleCompletionLog[]
  roomCheckIns                    RoomCheckIn[]
  // Account security fields
  isBlocked                       Boolean                          @default(false)
  forcePasswordChange             Boolean                          @default(false)
  temporaryUnblockUntil           DateTime?
  failedLoginCount                Int                              @default(0)
  lastFailedLoginAt               DateTime?
  settings                        Json?
  totpSecret                      String?
  totpEnabled                     Boolean                          @default(false)
  // Owner-level account: kept out of user listings and immutable to everyone else.
  // Authentication and authorization are unchanged - it is hidden, not privileged
  // beyond its role.
  isHidden                        Boolean                          @default(false)

  @@index([siteId])
  @@map("users")
}

model Site {
  id            String         @id @default(cuid())
  name          String         @unique
  address       String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  rooms         Room[]
  equipment     Equipment[]
  cleaningTasks CleaningTask[]
  schedules     Schedule[]

  @@map("sites")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation("UserTasks", fields: [userId], references: [id])

  @@index([userId])
  @@map("tasks")
}

model Room {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  floor                String?
  type                 RoomType       @default(OTHER)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  locationTokenVersion Int            @default(1)
  siteId               String?
  site                 Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tasks                CleaningTask[]
  schedules            RoomSchedule[]
  checkIns             RoomCheckIn[]

  @@unique([siteId, name])
  @@index([siteId])
  @@map("rooms")
}

model RoomCheckIn {
  id                   String                     @id @default(cuid())
  roomId               String
  userId               String
  method               VerificationMethod
  checkedInAt          DateTime                   @default(now())
  expiresAt            DateTime
  consumedAt           DateTime?
  locationTokenVersion Int
  room                 Room                       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionLog        RoomScheduleCompletionLog?

  @@index([userId, roomId, expiresAt])
  @@index([expiresAt])
  @@map("room_check_ins")
}

model Equipment {
  id           String              @id @default(cuid())
  name         String
  description  String?
  type         String              @default("OTHER")
  assetCode    String?
  model        String?
  serialNumber String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  siteId       String?
  site         Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  schedules    EquipmentSchedule[]

  @@unique([siteId, name])
  @@unique([siteId, assetCode])
  @@index([siteId])
  @@map("equipment")
}

model CleaningTask {
  id                String   @id @default(cuid())
  taskDescription   String
  frequency         String
  estimatedDuration String
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  roomId            String?
  room              Room?    @relation(fields: [roomId], references: [id])
  siteId            String?
  site              Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([roomId, taskDescription])
  @@index([siteId])
  @@map("cleaning_tasks")
}

model Schedule {
  id                 String              @id @default(cuid())
  title              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  detectedFrequency  String?
  suggestedFrequency ScheduleFrequency?
  // A schedule template can be shared across many sites (implicit m2m join
  // table _ScheduleToSite). It can then be assigned to rooms/equipment in any
  // of those sites.
  sites              Site[]
  equipment          EquipmentSchedule[]
  rooms              RoomSchedule[]
  tasks              ScheduleTask[]

  @@map("schedules")
}

model ScheduleTask {
  id              String   @id @default(cuid())
  description     String
  frequency       String?
  scheduleId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  additionalNotes String?
  schedule        Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_tasks")
}

model RoomSchedule {
  id             String                      @id @default(cuid())
  roomId         String
  scheduleId     String
  frequency      ScheduleFrequency
  startDate      DateTime                    @default(now())
  lastCompleted  DateTime?
  nextDue        DateTime
  status         ScheduleStatus              @default(PENDING)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  completionLogs RoomScheduleCompletionLog[]
  room           Room                        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  schedule       Schedule                    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([roomId, scheduleId])
  @@index([nextDue])
  @@index([status])
  @@map("room_schedules")
}

model EquipmentSchedule {
  id             String                           @id @default(cuid())
  equipmentId    String
  scheduleId     String
  frequency      ScheduleFrequency
  startDate      DateTime                         @default(now())
  lastCompleted  DateTime?
  nextDue        DateTime
  status         ScheduleStatus                   @default(PENDING)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  completionLogs EquipmentScheduleCompletionLog[]
  equipment      Equipment                        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  schedule       Schedule                         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, scheduleId])
  @@index([nextDue])
  @@index([status])
  @@map("equipment_schedules")
}

model RoomScheduleCompletionLog {
  id                 String             @id @default(cuid())
  roomScheduleId     String?
  completedAt        DateTime           @default(now())
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  completedTasks     Json               @default("[]")
  // Snapshots captured at completion time so the compliance record stays readable even
  // after the room/schedule is deleted (FK is SetNull, not Cascade).
  roomName           String?
  scheduleTitle      String?
  roomSchedule       RoomSchedule?      @relation(fields: [roomScheduleId], references: [id], onDelete: SetNull)
  completedByUserId  String?
  completedBy        User?              @relation(fields: [completedByUserId], references: [id])
  verificationMethod VerificationMethod @default(MANUAL)
  checkedInAt        DateTime?
  checkInId          String?            @unique
  checkIn            RoomCheckIn?       @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  // Sign-off captured on the cleaner's device at completion time. Nullable because
  // logs written before sign-off existed have none; the API requires all three on
  // every new completion.
  signatureDataUrl   String?
  signedName         String?
  signedAt           DateTime?

  @@index([roomScheduleId])
  @@index([completedAt])
  @@index([completedByUserId])
  @@map("room_schedule_completion_logs")
}

model EquipmentScheduleCompletionLog {
  id                  String             @id @default(cuid())
  equipmentScheduleId String?
  completedAt         DateTime           @default(now())
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  completedTasks      Json               @default("[]")
  // Snapshots so the compliance record survives deletion of the equipment/schedule.
  equipmentName       String?
  scheduleTitle       String?
  equipmentSchedule   EquipmentSchedule? @relation(fields: [equipmentScheduleId], references: [id], onDelete: SetNull)
  // Mirrors RoomScheduleCompletionLog. An equipment clean is the same kind of
  // compliance record as a room clean, so it carries the same sign-off: who did it,
  // the signature they drew and the name they printed. Nullable for the same reason
  // the room columns are - logs predating sign-off have none.
  completedByUserId   String?
  completedBy         User?              @relation(fields: [completedByUserId], references: [id])
  signatureDataUrl    String?
  signedName          String?
  signedAt            DateTime?

  @@index([equipmentScheduleId])
  @@index([completedAt])
  @@index([completedByUserId])
  @@map("equipment_schedule_completion_logs")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RoomType {
  OFFICE
  MEETING_ROOM
  BATHROOM
  KITCHEN
  LOBBY
  STORAGE
  OTHER
  BEDROOM
  LOUNGE
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum VerificationMethod {
  QR
  NFC
  MANUAL
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  loginAt      DateTime  @default(now())
  lastActivity DateTime  @default(now())
  logoutAt     DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, lastActivity])
  @@map("user_sessions")
}

enum UserRole {
  OP
  DIRECTOR
  MANAGER
  CLEANER
}

enum DocumentJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DocumentJob {
  id          String            @id @default(cuid())
  userId      String
  fileName    String
  fileType    String
  filePath    String
  status      DocumentJobStatus @default(PENDING)
  result      Json?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?

  @@index([userId, status])
  @@index([createdAt])
  @@map("document_jobs")
}
