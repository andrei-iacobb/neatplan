# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# document job uploads (temporary files)
/data/document-jobs/
*.pem
*.bak
*.fix
*.fix2

# logs
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# docker secrets
secrets/

# SMTP configuration (contains sensitive data)
.smtp-config.json

# generated prisma client
src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
test-results/
playwright-report/

# Local audit artifacts
.audit/

# Local Ralph loop state - contains DB credentials, never commit
.claude/ralph-loop.local.md

# Generated audit artifacts (large, with inline screenshots)
ui-audit.html
