# NeatPlan Environment Variables
# Copy this file to .env and update the values for your environment

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
NODE_ENV=production  # Use 'development' for local dev, 'production' for deployment
NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database

# Production (use strong random password!)
DATABASE_URL=postgresql://neatplan_user:CHANGE_TO_STRONG_PASSWORD@db:5432/neatplan

# Docker Compose variables (for local development)
POSTGRES_USER=neatplan_user
POSTGRES_DB=neatplan
POSTGRES_PASSWORD=CHANGE_TO_STRONG_PASSWORD

# ==============================================================================
# APPLICATION URL
# ==============================================================================
# Production - use your actual domain with HTTPS
NEXTAUTH_URL=https://neatplan.app

# Development - use localhost
# NEXTAUTH_URL=http://localhost:3000

# Public base URL (used by frontend)
NEXT_PUBLIC_APP_BASE_URL=https://neatplan.app

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Generate a secure random secret (min 32 characters):
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=GENERATE_A_STRONG_SECRET_HERE_64_CHARS_MINIMUM

# Cron job authentication secret (min 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=GENERATE_A_STRONG_SECRET_HERE_64_CHARS_MINIMUM

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Production - use your actual domain
CORS_ALLOWED_ORIGIN=https://neatplan.app

# Development - use localhost
# CORS_ALLOWED_ORIGIN=http://localhost:3000

# ==============================================================================
# IP WHITELISTING (Optional but Recommended for Production)
# ==============================================================================
# Comma-separated list of allowed IP addresses or CIDR ranges
# Example: ALLOWED_IPS=203.0.113.10,198.51.100.0/24,192.168.1.0/24
# Leave empty to disable IP whitelisting
ALLOWED_IPS=

# Force IP whitelist enforcement
# IP_WHITELIST_ENFORCE=true

# ==============================================================================
# SMTP / EMAIL CONFIGURATION (Optional - skip for now)
# ==============================================================================
# Email notifications are optional. App works without SMTP configured.
# Uncomment and configure when ready to enable email notifications.

# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=your_smtp_password_or_api_key
# SMTP_FROM=NeatPlan <noreply@neatplan.app>

# ==============================================================================
# OPENAI API (Optional - for AI-powered schedule processing)
# ==============================================================================
# Only needed if using document processing features with AI
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ==============================================================================
# OBSERVABILITY & RETENTION (Optional)
# ==============================================================================
# SESSION_RETENTION_DAYS=90
# SENTRY_DSN=https://example@sentry.io/project-id

# ==============================================================================
# QUICK START COMMANDS
# ==============================================================================
# 1. Copy this file: cp env.example .env
# 2. Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Update DATABASE_URL, NEXTAUTH_SECRET, CRON_SECRET with strong values
# 4. Update NEXTAUTH_URL and CORS_ALLOWED_ORIGIN to your domain
# 5. Validate: npm run validate-env
# 6. Deploy!
